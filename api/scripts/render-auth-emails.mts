// renders the Supabase auth email templates from the shared email layout. Supabase keeps
// these in the dashboard (Authentication > Email Templates), so after changing the layout or
// the copy, run this and paste each file into the matching template:
//   node api/scripts/render-auth-emails.mts
import { mkdirSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { renderEmail, type EmailContent } from '../src/services/email-layout.ts';

const ignore = "If you didn't ask for this, you can ignore this email.";

// {{ .X }} are Supabase's Go template variables and must survive as written
const templates: Array<{ file: string; dashboard: string; subject: string; content: EmailContent }> = [
	{
		file: 'confirm-signup.html',
		dashboard: 'Confirm signup',
		subject: 'Confirm your email for Baileys Analytics',
		content: {
			preheader: 'One click to finish creating your account.',
			heading: 'Confirm your email',
			paragraphs: ['Confirm {{ .Email }} to finish creating your Baileys Analytics account.'],
			action: { label: 'Confirm email', href: '{{ .ConfirmationURL }}' },
			after: ['Open the link in the browser where you signed up.', ignore],
		},
	},
	{
		file: 'reset-password.html',
		dashboard: 'Reset Password',
		subject: 'Reset your Baileys Analytics password',
		content: {
			preheader: 'Choose a new password for your account.',
			heading: 'Reset your password',
			paragraphs: ['Someone asked to reset the password for {{ .Email }}. If that was you, choose a new one below.'],
			action: { label: 'Choose a new password', href: '{{ .ConfirmationURL }}' },
			after: [`${ignore} Your password stays the same.`],
		},
	},
	{
		file: 'change-email.html',
		dashboard: 'Change Email Address',
		subject: 'Confirm your new email for Baileys Analytics',
		content: {
			preheader: 'Confirm the change to your sign-in email.',
			heading: 'Confirm your new email',
			paragraphs: ['Confirm that you want to change your sign-in email from {{ .Email }} to {{ .NewEmail }}.'],
			action: { label: 'Confirm new email', href: '{{ .ConfirmationURL }}' },
			after: [`${ignore} Your email stays the same.`],
		},
	},
	{
		file: 'magic-link.html',
		dashboard: 'Magic Link',
		subject: 'Your Baileys Analytics sign-in link',
		content: {
			preheader: 'Your link to sign in.',
			heading: 'Sign in to Baileys Analytics',
			paragraphs: ['Use this link to sign in as {{ .Email }}. It works once and expires soon.'],
			action: { label: 'Sign in', href: '{{ .ConfirmationURL }}' },
			after: [ignore],
		},
	},
	{
		file: 'invite-user.html',
		dashboard: 'Invite user',
		subject: "You're invited to Baileys Analytics",
		content: {
			preheader: 'Accept your invitation to Baileys Analytics.',
			heading: "You're invited",
			paragraphs: ['You have been invited to Baileys Analytics as {{ .Email }}. Accept the invitation to set up your account.'],
			action: { label: 'Accept invitation', href: '{{ .ConfirmationURL }}' },
			after: ["If you weren't expecting this, you can ignore this email."],
		},
	},
	{
		file: 'reauthentication.html',
		dashboard: 'Reauthentication',
		subject: 'Your Baileys Analytics confirmation code',
		content: {
			preheader: 'Your code to confirm this change.',
			heading: 'Confirm it is you',
			paragraphs: ['Enter this code in Baileys Analytics to confirm the change to your account.'],
			code: '{{ .Token }}',
			after: [`The code expires soon. ${ignore}`],
		},
	},
];

const outDir = join(dirname(fileURLToPath(import.meta.url)), '../../supabase/templates');
mkdirSync(outDir, { recursive: true });
for (const t of templates) writeFileSync(join(outDir, t.file), `${renderEmail(t.content)}\n`);

const readme = [
	'# Supabase auth email templates',
	'',
	'Generated by `node api/scripts/render-auth-emails.mts` from the shared layout in `api/src/services/email-layout.ts`. Do not edit the html by hand; change the script or the layout and regenerate.',
	'',
	'Paste each file into Supabase: Authentication > Email Templates, and set the subject.',
	'',
	'| Dashboard template | File | Subject |',
	'|---|---|---|',
	...templates.map((t) => `| ${t.dashboard} | \`${t.file}\` | ${t.subject} |`),
	'',
];
writeFileSync(join(outDir, 'README.md'), readme.join('\n'));
console.log(`wrote ${templates.length} templates to ${outDir}`);
