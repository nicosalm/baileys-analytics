{
	"name": "@baileys/api",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "wrangler dev --var COMMIT_SHA:$(git rev-parse HEAD)",
		"deploy": "wrangler deploy --env production --var COMMIT_SHA:$(git rev-parse HEAD)",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"types": "wrangler types",
		"tail": "wrangler tail --env production"
	},
	"devDependencies": {
		"vitest": "^5.1.1",
		"wrangler": "^4.165.0"
	},
	"dependencies": {
		"@baileys/constants": "workspace:*",
		"@supabase/supabase-js": "^2.119.2",
		"hono": "^4.13.19",
		"resend": "^6.39.0",
		"stripe": "^19.3.1",
		"zod": "^4.6.7"
	}
}
