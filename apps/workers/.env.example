# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Database Connection (Transaction Pooler)
# Use the transaction pooler for serverless environments
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# OwnerRez OAuth Credentials
OWNERREZ_CLIENT_ID=your-ownerrez-client-id
OWNERREZ_CLIENT_SECRET=your-ownerrez-client-secret

# OwnerRez Webhook Authentication
OWNERREZ_WEBHOOK_USER=baileysanalytics
OWNERREZ_WEBHOOK_PASSWORD=your-webhook-password-here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Stripe Price IDs (single tier - $20/mo, $192/yr)
# Replace with actual IDs from Stripe Dashboard
STRIPE_PRICE_MONTHLY=price_monthly_id
STRIPE_PRICE_YEARLY=price_yearly_id

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173