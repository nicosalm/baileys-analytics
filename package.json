{
  "name": "baileys-analytics",
  "version": "0.0.1",
  "private": true,
  "description": "Multi-tenant vacation rental analytics platform",
  "scripts": {
    "dev": "./run-dev.sh",
    "dev:backend": "cd apps/workers && pnpm dev",
    "dev:frontend": "cd apps/web && pnpm dev",
    "build": "pnpm -r build",
