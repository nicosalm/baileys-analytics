  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "@types/node": "^24.10.13",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.65.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "p-limit": "^6.2.0",
    "supabase": "^2.76.15",
    "zod": "^4.3.6"
  }
}
