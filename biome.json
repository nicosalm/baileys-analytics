{
	"$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!**/database.types.ts", "!**/worker-configuration.d.ts", "!**/public/updates"]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 140
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useExhaustiveDependencies": "warn"
			},
			"suspicious": {
				"noArrayIndexKey": "warn",
				"useIterableCallbackReturn": "warn"
			},
			"a11y": {
				"useKeyWithClickEvents": "warn",
				"noStaticElementInteractions": "warn",
				"noSvgWithoutTitle": "warn",
				"useValidAnchor": "warn",
				"noLabelWithoutControl": "warn",
				"useSemanticElements": "warn"
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["apps/web/**", "packages/utils/**"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			},
			"javascript": {
				"formatter": {
					"semicolons": "asNeeded"
				}
			}
		},
		{
			"includes": ["apps/workers/**", "packages/constants/**"],
			"formatter": {
				"indentStyle": "tab"
			},
			"javascript": {
				"formatter": {
					"semicolons": "always"
				}
			}
		},
		{
			"includes": ["**/*.test.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noThenProperty": "off",
						"noExplicitAny": "off"
					}
				}
			}
		}
	]
}
